{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.CLAUDE_PROJECT_DIR,'.hooks','run-hook.cjs'))\" session-start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.CLAUDE_PROJECT_DIR,'.hooks','run-hook.cjs'))\" session-end"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.CLAUDE_PROJECT_DIR,'.hooks','run-hook.cjs'))\" validate-write",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.CLAUDE_PROJECT_DIR,'.hooks','run-hook.cjs'))\" autocommit",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
